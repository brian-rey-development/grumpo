---
interface Props {
  id: string;
  title: string;
  tone?: 'light' | 'ink';
  class?: string;
}

const { id, title, tone = 'light', class: className } = Astro.props;
---

<header class:list={['max-w-measure', className]}>
  <h2 id={id} class="text-display tracking-tight">
    {title}
  </h2>
  {Astro.slots.has('default') && (
    <div
      class:list={[
        'mt-5 space-y-4 text-lede',
        tone === 'ink' ? 'text-on-ink-soft' : 'text-ink-soft',
      ]}
    >
      <slot />
    </div>
  )}
</header>
