---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary';
type Size = 'sm' | 'md' | 'lg';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: Variant;
  size?: Size;
}

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'border-ink bg-orange text-ink shadow-hard press',
  secondary: 'border-ink bg-raised text-ink shadow-hard press',
};

const sizes: Record<Size, string> = {
  sm: 'h-10 px-4 text-[0.9375rem]',
  md: 'h-11 px-5 text-base',
  lg: 'h-14 px-7 text-lg',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2.5 rounded-control border-3 font-display font-semibold tracking-tight whitespace-nowrap',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
