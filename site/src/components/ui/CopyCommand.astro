---
interface Props {
  command: string;
  class?: string;
}

const PATH_BREAK = /(?<=[^/:])(?=\/)/;

const { command, class: className } = Astro.props;
const segments = command.split(PATH_BREAK);
---

<div data-copy class:list={['@container', className]}>
  <div class="flex flex-col gap-2 rounded-control border-3 border-ink bg-ink p-2 pl-5 text-on-ink @md:flex-row @md:items-center @md:gap-3">
    <pre
      tabindex="0"
      class="min-w-0 flex-1 py-2 pr-3 font-mono text-sm leading-relaxed break-words whitespace-pre-wrap"
    ><code data-copy-source>{segments.map((segment, index) => <>{index > 0 && <wbr />}{segment}</>)}</code></pre>
    <button
      type="button"
      data-copy-button
      aria-label="Copy command"
      hidden
      class="h-10 shrink-0 self-end rounded-control border-2 border-on-ink bg-orange px-4 font-display font-semibold text-ink transition-colors hover:bg-raised @md:self-auto"
    >
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <span data-copy-status role="status" class="sr-only"></span>
</div>

<script>
  import { mountCopyCommands } from '@/scripts/copy-command';

  mountCopyCommands();
</script>
