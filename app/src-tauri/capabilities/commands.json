{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "commands",
  "description": "Grants the main window the app's own commands",
  "windows": ["main"],
  "permissions": [
    "allow-get-day-report",
    "allow-get-week-report",
    "allow-get-limit-usage",
    "allow-get-focus-status",
    "allow-save-rules",
    "allow-request-unlock",
    "allow-confirm-unlock",
    "allow-cancel-unlock",
    "allow-relock",
    "allow-list-known-apps",
    "allow-get-app-icon",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-permissions",
    "allow-request-permission",
    "allow-open-permission-settings",
    "allow-export-data",
    "allow-delete-all-data",
    "allow-get-clock-style",
    "allow-install-service",
    "allow-get-onboarding-state",
    "allow-complete-onboarding",
    "allow-reset-onboarding"
  ]
}
